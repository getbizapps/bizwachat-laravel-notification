{
  "name": "getbizapps/bizwachat-laravel-notification",
  "version": "1.0.0",
  "description": "Laravel notification channel and API client for Bizwachat public API.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Bizwachat",
      "email": "hello@getbizapps.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/http": "^10.0|^11.0|^12.0",
    "illuminate/notifications": "^10.0|^11.0|^12.0",
    "illuminate/support": "^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "BizwaChat\\LaravelNotification\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "BizwaChat\\LaravelNotification\\BizwaChatServiceProvider"
      ],
      "aliases": {
        "BizwaChat": "BizwaChat\\LaravelNotification\\Facades\\BizwaChat"
      }
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}